{
  "name": "workshop-display-system",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --input-type=module -e \"process.env.NODE_ENV = 'development'; await import('./server-entry.ts')\"",
    "build": "vite build && esbuild server-entry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "node --import tsx --test tests/api.test.ts tests/operator-access.test.ts tests/operator-auth.test.ts tests/firebase-admin.test.ts",
    "emulator:firestore": "firebase emulators:start --only firestore --project demo-workshop-display",
    "test:firestore-emulator": "node --import tsx --test tests/firestore-emulator.test.ts",
    "test:security-emulator": "firebase emulators:exec --only firestore,storage --project demo-workshop-display \"node --import tsx --test tests/firestore-emulator.test.ts tests/security-rules.test.ts\"",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "15.31.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
